# Production environment variables (Ubuntu server)

# Server
APP_PORT=8080

# Redis
REDIS_HOST=<YOUR_REDIS_HOST>
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=<YOUR_KAFKA_HOST>:9092

# MySQL
DB_URL=jdbc:mysql://<YOUR_DB_HOST>:3306/<YOUR_DB_NAME>?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
DB_USERNAME=<YOUR_DB_USER>
DB_PASSWORD=<YOUR_DB_PASSWORD>
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Google OAuth2
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

# SSAFY OAuth2 (optional)
SSAFY_CLIENT_ID=<YOUR_SSAFY_CLIENT_ID>
SSAFY_CLIENT_SECRET=<YOUR_SSAFY_CLIENT_SECRET>
SSAFY_AUTHORIZATION_URI=https://project.ssafy.com/oauth/sso-check
SSAFY_TOKEN_URI=https://project.ssafy.com/ssafy/oauth2/token
SSAFY_USER_INFO_URI=https://project.ssafy.com/ssafy/resources/userInfo
SSAFY_USER_NAME_ATTRIBUTE=userId
SSAFY_SCOPE=profile,email

# Auth redirect (production domain)
APP_AUTH_DEFAULT_REDIRECT_URL=https://pss6161.bunnect.kr/swagger-ui/index.html
APP_AUTH_ALLOWED_REDIRECT_ORIGINS=https://pss6161.bunnect.kr

# Disable docker compose auto integration in server runtime
SPRING_DOCKER_COMPOSE_ENABLED=false
