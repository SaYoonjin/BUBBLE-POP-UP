# Production environment variables (Ubuntu server)

# Server
APP_PORT=8080

# Redis (container on web server)
REDIS_HOST=redis
REDIS_PORT=6379

# MySQL (RDS)
DB_URL=jdbc:mysql://<YOUR_DB_HOST>:3306/<YOUR_DB_NAME>?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
DB_USERNAME=<YOUR_DB_USER>
# Keep raw value without quotes. Docker env_file does not need shell escaping.
DB_PASSWORD=<YOUR_DB_PASSWORD>
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Nginx container
NGINX_SERVER_NAME=<YOUR_API_DOMAIN>
NGINX_SSL_CERT_PATH=/etc/letsencrypt/live/<YOUR_API_DOMAIN>/fullchain.pem
NGINX_SSL_KEY_PATH=/etc/letsencrypt/live/<YOUR_API_DOMAIN>/privkey.pem

# Google OAuth2
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

# SSAFY OAuth2 (optional)
SSAFY_CLIENT_ID=<YOUR_SSAFY_CLIENT_ID>
SSAFY_CLIENT_SECRET=<YOUR_SSAFY_CLIENT_SECRET>
SSAFY_AUTHORIZATION_URI=https://project.ssafy.com/oauth/sso-check
SSAFY_TOKEN_URI=https://project.ssafy.com/ssafy/oauth2/token
SSAFY_USER_INFO_URI=https://project.ssafy.com/ssafy/resources/userInfo
SSAFY_USER_NAME_ATTRIBUTE=userId
SSAFY_SCOPE=profile,email

# Auth redirect (production domain)
APP_AUTH_DEFAULT_REDIRECT_URL=/swagger-ui/index.html
APP_AUTH_ALLOWED_REDIRECT_ORIGINS=https://<YOUR_API_DOMAIN>,http://localhost:8080

# Disable docker compose auto integration in server runtime
SPRING_DOCKER_COMPOSE_ENABLED=false
