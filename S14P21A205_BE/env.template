# Copy this file to .env for local development.
# Example: cp env.template .env

# region ===== Server =====
APP_PORT=8080
# endregion

# region ===== Redis (local Docker port mapping) =====
REDIS_HOST=localhost
REDIS_PORT=6379
# endregion

# region ===== MySQL (local Docker port mapping) =====
DB_URL=jdbc:mysql://localhost:13306/mydb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
DB_USERNAME=myuser
DB_PASSWORD=mypassword
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
# endregion

# region ===== Google OAuth2 (Required) =====
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# endregion

# region ===== SSAFY OAuth2 (Optional: enable when using SSAFY login) =====
SSAFY_CLIENT_ID=your-ssafy-client-id
SSAFY_CLIENT_SECRET=your-ssafy-client-secret
SSAFY_AUTHORIZATION_URI=https://project.ssafy.com/oauth/sso-check
SSAFY_TOKEN_URI=https://project.ssafy.com/ssafy/oauth2/token
SSAFY_USER_INFO_URI=https://project.ssafy.com/ssafy/resources/userInfo
SSAFY_USER_NAME_ATTRIBUTE=userId
SSAFY_SCOPE=profile,email
# endregion

# region ===== Auth Redirect =====
APP_AUTH_DEFAULT_REDIRECT_URL=/swagger-ui/index.html
APP_AUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# endregion
